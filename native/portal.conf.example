# Configuración del Portal Cautivo - Linux Nativo
#
# Generado por install.sh en /etc/captive-portal/portal.conf si no existía.
# Edítalo (o usa configure-interfaces.sh) y luego corre start-portal.sh.
#
# Este mismo archivo se usa de dos formas: los scripts de native/ lo hacen
# "source" como bash, y systemd lo lee como EnvironmentFile del servicio
# captive-portal (por eso son líneas KEY=VALUE simples, sin espacios ni
# comillas alrededor del valor).

# ============================================================================
# INTERFACES DE RED
# ============================================================================

# Interfaz WAN (conexión a Internet). Ejemplos: enp0s3, eth0, ens33
UPLINK_IF=enp0s3

# Interfaz LAN (donde se conectan los clientes). Ejemplos: enp0s8, eth1
LAN_IF=enp0s8

# ============================================================================
# RED LAN
# ============================================================================

# IP del portal en la LAN. Los clientes la usan como gateway y DNS.
LAN_IP=192.168.100.1

# Subred LAN en notación CIDR (debe coincidir con LAN_IP).
LAN_CIDR=192.168.100.0/24

# ============================================================================
# PUERTOS
# ============================================================================

# Puerto del backend Python (interno; solo nginx le habla, por loopback).
PORTAL_PORT=8080

# Puerto HTTP: clientes no autenticados son redirigidos aquí.
NGINX_HTTP_PORT=80

# Puerto HTTPS: portal de autenticación.
NGINX_HTTPS_PORT=443

# ============================================================================
# DNS + DHCP (dnsmasq)
# ============================================================================

# Tamaño de la caché DNS (número de entradas).
DNS_CACHE_SIZE=1000

# Rango de IPs que dnsmasq entrega por DHCP a los clientes (últimos
# octetos, dentro de LAN_CIDR). Con los valores por defecto: de
# 192.168.100.100 a 192.168.100.200.
DHCP_RANGE_START=100
DHCP_RANGE_END=200

# Duración del lease DHCP. Ejemplos: 12h, 1h, 30m.
DHCP_LEASE=12h

# ============================================================================
# PORTAL
# ============================================================================

# Duración de la sesión autenticada, en segundos.
AUTH_TIMEOUT=3600

# Nombre del certificado TLS (Common Name). dnsmasq resuelve este nombre a
# LAN_IP para los clientes de la LAN.
CERT_CN=portal.hastalap

# ============================================================================
# RUTAS DEL SISTEMA (fijadas por install.sh; normalmente no se tocan)
# ============================================================================

APP_DIR=/opt/captive-portal
USERS_FILE=/opt/captive-portal/app/users.json

# ============================================================================
# NOTAS
# ============================================================================
#
# 1. INTERFACES: tras editar este archivo, corre "sudo ./configure-interfaces.sh"
#    (o aplica UPLINK_IF/LAN_IF/LAN_IP a mano) y luego "sudo ./start-portal.sh".
#
# 2. USUARIOS: no hay credenciales por defecto predecibles. En el primer
#    arranque se genera una contraseña aleatoria para "admin" y se muestra
#    una sola vez por consola y en /opt/captive-portal/app/admin_password_initial.txt
#    (permisos 600). Cámbiala o crea más usuarios desde
#    https://<CERT_CN>/admin/users.
#
# 3. TLS: certificado autofirmado, generado automáticamente en
#    /etc/captive-portal/ssl/portal.{key,crt}. Los navegadores mostrarán una
#    advertencia de seguridad -- normal en portales cautivos sin CA propia.
#
# 4. LOGS: backend y auditoría en /var/log/captive-portal/,
#    nginx en /var/log/nginx/, dnsmasq vía journalctl (systemd).
# ============================================================================
